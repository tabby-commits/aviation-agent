<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kama.jchatmind.mapper.PaperTaxonomyMapper">

    <resultMap id="BaseResultMap" type="com.kama.jchatmind.model.entity.PaperTaxonomy">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="docId" column="doc_id" jdbcType="VARCHAR"/>
        <result property="taxonomyCode" column="taxonomy_code" jdbcType="VARCHAR"/>
        <result property="membershipType" column="membership_type" jdbcType="VARCHAR"/>
        <result property="source" column="source" jdbcType="VARCHAR"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insertIgnore" parameterType="com.kama.jchatmind.model.entity.PaperTaxonomy"
            keyColumn="id" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO paper_taxonomy (doc_id, taxonomy_code, membership_type, source, created_at)
        VALUES (#{docId}, #{taxonomyCode}, #{membershipType}, #{source}, now())
        ON CONFLICT (doc_id, taxonomy_code, membership_type) DO NOTHING
    </insert>

    <select id="selectByDocId" resultMap="BaseResultMap">
        SELECT id, doc_id, taxonomy_code, membership_type, source, created_at
        FROM paper_taxonomy
        WHERE doc_id = #{docId}
        ORDER BY created_at ASC
    </select>

    <delete id="deleteByTaxonomyCode">
        DELETE
        FROM paper_taxonomy
        WHERE taxonomy_code = #{code}
    </delete>

    <delete id="deleteBySource">
        DELETE
        FROM paper_taxonomy
        WHERE source = #{source}
    </delete>

    <select id="countByCode" resultType="int">
        SELECT COUNT(*)
        FROM paper_taxonomy
        WHERE taxonomy_code = #{code}
    </select>
</mapper>
